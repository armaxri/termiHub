    {
      "name": "anyOf: info shown when the first alternative holds",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
          "anyOf": [
            { "field": "useSshTunnel", "equals": false },
            { "field": "host", "sameHostAs": "sshHost", "equals": true }
          ]
        }
      },
      "args": {
        "settings": {
          "fileTransfer": true,
          "useSshTunnel": false,
          "host": "10.0.4.17",
          "sshHost": "bastion.corp"
        }
      },
      "expected": true
    },
    {
      "name": "anyOf: info shown when the second alternative holds",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
