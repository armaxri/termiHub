{
  "operation": "isFieldVisible",
  "cases": [
    {
      "name": "returns true for fields without visibleWhen",
      "input": { "key": "host", "label": "host", "fieldType": { "type": "text" }, "required": false },
      "args": { "settings": {} },
      "expected": true
    },
    {
      "name": "returns true when condition is met",
      "input": {
        "key": "password",
        "label": "password",
        "fieldType": { "type": "password" },
        "required": false,
        "visibleWhen": { "field": "authMethod", "equals": "password" }
      },
      "args": { "settings": { "authMethod": "password" } },
      "expected": true
    },
    {
      "name": "returns false when condition is not met",
      "input": {
        "key": "password",
        "label": "password",
        "fieldType": { "type": "password" },
        "required": false,
        "visibleWhen": { "field": "authMethod", "equals": "password" }
      },
      "args": { "settings": { "authMethod": "key" } },
      "expected": false
    },
    {
      "name": "boolean condition value true matches",
      "input": {
        "key": "extraOption",
        "label": "extraOption",
        "fieldType": { "type": "text" },
        "required": false,
        "visibleWhen": { "field": "advanced", "equals": true }
      },
      "args": { "settings": { "advanced": true } },
      "expected": true
    },
    {
      "name": "boolean condition value false does not match",
      "input": {
        "key": "extraOption",
        "label": "extraOption",
        "fieldType": { "type": "text" },
        "required": false,
        "visibleWhen": { "field": "advanced", "equals": true }
      },
      "args": { "settings": { "advanced": false } },
      "expected": false
    },
    {
      "name": "numeric condition value matches",
      "input": {
        "key": "highPort",
        "label": "highPort",
        "fieldType": { "type": "text" },
        "required": false,
        "visibleWhen": { "field": "mode", "equals": 2 }
      },
      "args": { "settings": { "mode": 2 } },
      "expected": true
    },
    {
      "name": "numeric condition value does not match",
      "input": {
        "key": "highPort",
        "label": "highPort",
        "fieldType": { "type": "text" },
        "required": false,
        "visibleWhen": { "field": "mode", "equals": 2 }
      },
      "args": { "settings": { "mode": 1 } },
      "expected": false
    },
    {
      "name": "returns false when referenced field is missing",
      "input": {
        "key": "extra",
        "label": "extra",
        "fieldType": { "type": "text" },
        "required": false,
        "visibleWhen": { "field": "mode", "equals": "advanced" }
      },
      "args": { "settings": {} },
      "expected": false
    },
    {
      "name": "sameHostAs: differing hosts satisfy equals false",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "host",
          "sameHostAs": "sshHost",
          "equals": false
        }
      },
      "args": {
        "settings": { "host": "10.0.4.17", "sshHost": "bastion.corp" }
      },
      "expected": true
    },
    {
      "name": "sameHostAs: loopback target satisfies equals true",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "host",
          "sameHostAs": "sshHost",
          "equals": true
        }
      },
      "args": {
        "settings": { "host": "127.0.0.1", "sshHost": "bastion.corp" }
      },
      "expected": true
    },
    {
      "name": "sameHostAs: an empty side compares as the same host",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "host",
          "sameHostAs": "sshHost",
          "equals": false
        }
      },
      "args": { "settings": { "host": "10.0.4.17", "sshHost": "  " } },
      "expected": false
    },
    {
      "name": "sameHostAs: a missing side compares as the same host",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "host",
          "sameHostAs": "sshHost",
          "equals": true
        }
      },
      "args": { "settings": { "sshHost": "bastion.corp" } },
      "expected": true
    },
    {
      "name": "sameHostAs: a non-string side compares as the same host",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "host",
          "sameHostAs": "sshHost",
          "equals": true
        }
      },
      "args": { "settings": { "host": 42, "sshHost": "bastion.corp" } },
      "expected": true
    },
    {
      "name": "allOf: gateway warning shown",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
          "allOf": [
            { "field": "useSshTunnel", "equals": true },
            { "field": "host", "sameHostAs": "sshHost", "equals": false }
          ]
        }
      },
      "args": {
        "settings": {
          "fileTransfer": true,
          "useSshTunnel": true,
          "host": "10.0.4.17",
          "sshHost": "bastion.corp"
        }
      },
      "expected": true
    },
    {
      "name": "allOf: warning hidden when one sub-condition fails",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
          "allOf": [
            { "field": "useSshTunnel", "equals": true },
            { "field": "host", "sameHostAs": "sshHost", "equals": false }
          ]
        }
      },
      "args": {
        "settings": {
          "fileTransfer": true,
          "useSshTunnel": false,
          "host": "10.0.4.17",
          "sshHost": "bastion.corp"
        }
      },
      "expected": false
    },
    {
      "name": "allOf: warning hidden when the primary fails",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
          "allOf": [
            { "field": "useSshTunnel", "equals": true },
            { "field": "host", "sameHostAs": "sshHost", "equals": false }
          ]
        }
      },
      "args": {
        "settings": {
          "fileTransfer": false,
          "useSshTunnel": true,
          "host": "10.0.4.17",
          "sshHost": "bastion.corp"
        }
      },
      "expected": false
    },
    {
      "name": "anyOf: info hidden in the gateway case",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "fileTransfer",
          "equals": true,
          "anyOf": [
            { "field": "useSshTunnel", "equals": false },
            { "field": "host", "sameHostAs": "sshHost", "equals": true }
