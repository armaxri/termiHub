    {
      "name": "nested: allOf inside anyOf",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "a",
          "equals": 1,
          "anyOf": [
            {
              "field": "b",
              "equals": 2,
              "allOf": [{ "field": "c", "equals": 3 }]
            }
          ]
        }
      },
      "args": { "settings": { "a": 1, "b": 2, "c": 3 } },
      "expected": true
    },
    {
      "name": "nested: allOf inside anyOf fails",
      "input": {
        "key": "n",
        "label": "",
        "fieldType": { "type": "notice", "severity": "warning" },
        "required": false,
        "visibleWhen": {
          "field": "a",
          "equals": 1,
          "anyOf": [
            {
              "field": "b",
              "equals": 2,
              "allOf": [{ "field": "c", "equals": 3 }]
            }
          ]
        }
      },
      "args": { "settings": { "a": 1, "b": 2, "c": 4 } },
      "expected": false
    },
    {
