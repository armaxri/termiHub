{
  "operation": "findPasswordPromptInfo",
  "cases": [
    {
      "name": "returns prompt info when password field is visible and empty",
      "input": {
        "groups": [
          {
            "key": "connection",
            "label": "Connection",
            "fields": [
              { "key": "host", "label": "host", "fieldType": { "type": "text" }, "required": true },
              { "key": "username", "label": "username", "fieldType": { "type": "text" }, "required": true }
            ]
          },
          {
            "key": "authentication",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "select", "options": [ { "value": "key", "label": "SSH Key" }, { "value": "password", "label": "Password" } ] }, "required": true, "default": "key" },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } }
            ]
          }
        ]
      },
      "args": { "settings": { "authMethod": "password", "host": "example.com", "username": "admin" } },
      "expected": { "hostKey": "host", "usernameKey": "username", "passwordKey": "password" }
    },
    {
      "name": "returns null when password field is not visible",
      "input": {
        "groups": [
          {
            "key": "authentication",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "text" }, "required": true },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } }
            ]
          }
        ]
      },
      "args": { "settings": { "authMethod": "key" } },
      "expected": null
    },
    {
      "name": "returns null when password is already set",
      "input": {
        "groups": [
          {
            "key": "authentication",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "text" }, "required": true },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } }
            ]
          }
        ]
      },
      "args": { "settings": { "authMethod": "password", "password": "secret" } },
      "expected": null
    },
    {
      "name": "returns null when schema has no password fields",
      "input": {
        "groups": [
          { "key": "conn", "label": "Connection", "fields": [ { "key": "host", "label": "host", "fieldType": { "type": "text" }, "required": false } ] }
        ]
      },
      "args": { "settings": {} },
      "expected": null
    },
    {
      "name": "returns prompt info for unconditional password field",
      "input": {
        "groups": [
          {
            "key": "conn",
            "label": "Connection",
            "fields": [
              { "key": "host", "label": "host", "fieldType": { "type": "text" }, "required": false },
              { "key": "username", "label": "username", "fieldType": { "type": "text" }, "required": false },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false }
            ]
          }
        ]
      },
      "args": { "settings": { "host": "h", "username": "u" } },
      "expected": { "hostKey": "host", "usernameKey": "username", "passwordKey": "password" }
    }
  ]
}
