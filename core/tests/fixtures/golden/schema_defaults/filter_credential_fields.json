              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } },
              { "key": "savePassword", "label": "Save password", "fieldType": { "type": "boolean" }, "required": false, "default": false },
              { "key": "keyPath", "label": "keyPath", "fieldType": { "type": "text" }, "required": false }
            ]
          }
        ]
      },
      "args": { "credentialMode": "master_password" },
      "expected": {
