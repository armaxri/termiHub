        "groups": [
          {
            "key": "auth",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "select", "options": [ { "value": "password", "label": "Password" } ] }, "required": true },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } },
