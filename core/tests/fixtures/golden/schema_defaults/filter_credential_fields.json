{
  "operation": "filterCredentialFields",
  "cases": [
    {
      "name": "removes password and savePassword fields when mode is 'none'",
      "input": {
        "groups": [
          {
            "key": "auth",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "select", "options": [ { "value": "password", "label": "Password" } ] }, "required": true },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "visibleWhen": { "field": "authMethod", "equals": "password" } },
              { "key": "savePassword", "label": "Save password", "fieldType": { "type": "boolean" }, "required": false, "default": false },
              { "key": "keyPath", "label": "keyPath", "fieldType": { "type": "text" }, "required": false }
            ]
          }
        ]
      },
      "args": { "credentialMode": "none" },
      "expected": {
        "groups": [
          {
            "key": "auth",
            "label": "Authentication",
            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "select", "options": [ { "value": "password", "label": "Password" } ] }, "required": true, "supportsEnvExpansion": false, "supportsTildeExpansion": false },
              { "key": "keyPath", "label": "keyPath", "fieldType": { "type": "text" }, "required": false, "supportsEnvExpansion": false, "supportsTildeExpansion": false }
            ]
          }
        ]
      }
    },
    {
      "name": "keeps all fields when mode is 'master_password'",
