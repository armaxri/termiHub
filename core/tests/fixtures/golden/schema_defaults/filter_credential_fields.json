            "fields": [
              { "key": "authMethod", "label": "Auth Method", "fieldType": { "type": "select", "options": [ { "value": "password", "label": "Password" } ] }, "required": true, "supportsEnvExpansion": false, "supportsTildeExpansion": false },
              { "key": "password", "label": "password", "fieldType": { "type": "password" }, "required": false, "supportsEnvExpansion": false, "supportsTildeExpansion": false, "visibleWhen": { "field": "authMethod", "equals": "password" } },
              { "key": "savePassword", "label": "Save password", "fieldType": { "type": "boolean" }, "required": false, "default": false, "supportsEnvExpansion": false, "supportsTildeExpansion": false },
              { "key": "keyPath", "label": "keyPath", "fieldType": { "type": "text" }, "required": false, "supportsEnvExpansion": false, "supportsTildeExpansion": false }
            ]
          }
        ]
      }
    },
