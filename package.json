{
  "name": "termihub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/internal/tauri.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" \"*.md\"",
    "markdownlint": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "markdownlint:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@lucide/lab": "^0.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@shikijs/monaco": "^4.1.0",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.563.0",
    "match-sorter": "^8.3.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.76.1",
    "react-resizable-panels": "^4.11.2",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "uplot": "^1.6.32",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "overrides": {
      "dompurify": ">=3.4.12 <4",
      "markdown-it": ">=14.2.0 <15",
      "js-yaml": ">=4.2.0 <5",
      "serialize-javascript": ">=7.0.5",
      "flatted": ">=3.4.2",
      "fast-uri": ">=3.1.2",
      "rollup": ">=4.59.0",
      "postcss": ">=8.5.10",
      "undici": ">=7.28.0 <8",
      "vite>picomatch": ">=4.0.4",
      "vitest>picomatch": ">=4.0.4",
      "anymatch>picomatch": "2.3.2",
      "readdirp>picomatch": "2.3.2",
      "micromatch>picomatch": "2.3.2",
      "minimatch@3>brace-expansion": "1.1.14",
      "minimatch@5>brace-expansion": ">=2.0.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.1.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.7",
    "ws": "^8.21.0"
  }
