#!/usr/bin/env bash
# Git pre-push hook (issue TOOL-007). Runs the FAST subset of the local CI gate
# (scripts/ci-local.sh --quick: formatting, lint, clippy, tsc, cargo fmt,
# commitlint) before a push, so the common CI reds are caught locally. It is
# deliberately NOT the full gate (no cargo test / coverage / audits) — those are
# minutes-long and belong in `./scripts/ci-local.sh`, which you run before opening
# a PR. Enabled via core.hooksPath (scripts/setup.sh).
#
# Bypass with `git push --no-verify` or `export TERMIHUB_SKIP_HOOKS=1`.
set -euo pipefail

if [ -n "${TERMIHUB_SKIP_HOOKS:-}" ]; then
  echo "pre-push: skipped (TERMIHUB_SKIP_HOOKS set)"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

exec ./scripts/ci-local.sh --quick
