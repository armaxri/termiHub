#!/usr/bin/env bash
# Git pre-commit hook (issue TOOL-007). Fast, staged-only formatting/lint gate —
# must stay in the "seconds" range so it never gets in the way. Enabled via
# `git config core.hooksPath scripts/hooks` (done by scripts/setup.sh).
#
# Bypass a single commit with `git commit --no-verify`, or disable all repo hooks
# for a shell with `export TERMIHUB_SKIP_HOOKS=1`.
set -euo pipefail

if [ -n "${TERMIHUB_SKIP_HOOKS:-}" ]; then
  echo "pre-commit: skipped (TERMIHUB_SKIP_HOOKS set)"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Only added/copied/modified staged files — deleted paths must not be linted.
staged=()
while IFS= read -r line; do
  [ -n "$line" ] && staged+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACM)

[ ${#staged[@]} -eq 0 ] && exit 0

# Match exactly what CI's format:check / lint cover (package.json globs), so the
# hook can never fail on a file the CI gate would not check.
prettier_files=()
eslint_files=()
for f in "${staged[@]}"; do
  case "$f" in
    src/*.ts | src/*.tsx | src/*.css | docs/*.md) prettier_files+=("$f") ;;
    */*) : ;;             # any other nested path: not in a format:check glob
    *.md) prettier_files+=("$f") ;;  # root-level markdown (README, etc.)
  esac
  case "$f" in
    src/*.ts | src/*.tsx) eslint_files+=("$f") ;;
  esac
done

if [ ${#prettier_files[@]} -gt 0 ]; then
  echo "pre-commit: prettier --check (${#prettier_files[@]} file(s))"
  pnpm exec prettier --check "${prettier_files[@]}"
fi

if [ ${#eslint_files[@]} -gt 0 ]; then
  echo "pre-commit: eslint (${#eslint_files[@]} file(s))"
  pnpm exec eslint "${eslint_files[@]}"
fi

echo "pre-commit: OK"
