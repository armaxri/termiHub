# Sideloaded ConPTY host bundled with the Windows desktop app (#4121).
#
# portable-pty prefers a conpty.dll found next to termihub.exe over the inbox
# kernel32 ConPTY; that conpty.dll starts the OpenConsole.exe beside it as the
# console host. The inbox host strips SIXEL/inline-image DCS strings; the
# packaged host passes them through. Both files come from Microsoft's official
# Microsoft.Windows.Console.ConPTY NuGet package (MIT, github.com/microsoft/terminal).
#
# The binaries are NEVER committed. scripts/internal/fetch-conpty.sh (and its
# .cmd/.ps1 twin) download the package at build time, refuse it unless its
# SHA-256 matches CONPTY_NUPKG_SHA256, then check each extracted file against
# its own pin below before staging it in src-tauri/binaries/conpty/.
#
# Bumping: pick a stable (non -preview) version from
#   https://api.nuget.org/v3-flatcontainer/microsoft.windows.console.conpty/index.json
# download its .nupkg, record `sha256sum` of the package and of the four files
# below (paths inside the package are listed next to each pin), update the
# version in THIRD_PARTY_LICENSES.md, and run the Windows inline-image system
# test (tests/system/tests/test_terminal_inline_images.py).
#
# Plain KEY=VALUE lines only: the bash script sources this file and the
# PowerShell twin parses it with a regex.
CONPTY_VERSION=1.24.261001001
CONPTY_NUPKG_SHA256=4d6aaddc1d2385c9f5897df28f33879f699f8f2783315d5204cf3d8c3616ac5f
# runtimes/win-x64/native/conpty.dll
CONPTY_DLL_X64_SHA256=5afea6c9480e2c7dfd195376dd10996b0ae25cdc6f014e6247fd8aedc8c34852
# build/native/runtimes/x64/OpenConsole.exe
OPENCONSOLE_X64_SHA256=6f8e68dec4e8e5e15a54ecc8afa127b0e62139edc004ffbb4892125ff01d5737
# runtimes/win-arm64/native/conpty.dll
CONPTY_DLL_ARM64_SHA256=015cb55e4f82b0b2bf008dfd98a0398c8239db186b9a6846f66eb918cfe3dd17
# build/native/runtimes/arm64/OpenConsole.exe
OPENCONSOLE_ARM64_SHA256=5e4370eb99c591e2e68ed094079b56a16c9c5a00d1b76f684c46c9139439c303
