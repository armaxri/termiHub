    {
      "createdAt": "2026-09-01T10:00:00Z",
      "description": "Pull, build and restart the web tier",
      "id": "workflow-01JDWF00000000000000000001",
      "legacy": {
        "from": "workflow",
        "version": 3
      },
      "name": "Deploy prep",
      "parameters": [
        {
          "default": "web",
          "label": "Application",
          "name": "app",
          "required": true,
          "type": "string"
        },
        {
          "default": "dev",
          "name": "env",
          "options": [
            "dev",
            "prod"
          ],
          "type": "enum"
        },
        {
          "default": 2,
          "name": "replicas",
          "type": "number"
        },
        {
          "default": false,
          "name": "dryRun",
          "type": "boolean"
        }
      ],
      "steps": [
        {
          "command": "cd /srv/${app}",
          "kind": "send-command"
        },
        {
          "kind": "run-script",
          "perLineDelayMs": 50,
          "retry": {
            "backoff": "exponential",
            "count": 3,
            "delayMs": 500
          },
          "script": "git pull\nmake build ENV=${env}",
          "sourcePath": "/home/ops/deploy.sh"
        },
        {
          "automationId": "macro-01JDREC0000000000000000001",
          "continueOnError": true,
          "kind": "run-automation"
        },
        {
          "delayMs": 500,
          "kind": "wait"
        },
        {
          "isRegex": true,
          "kind": "wait-for-output",
          "pattern": "Build (OK|DONE)",
          "retry": {
            "count": 1
          },
          "timeoutMs": 60000
        },
        {
          "kind": "wait-for-output",
          "pattern": "$ "
        },
        {
          "args": [
            "deployed",
            "${app}"
          ],
          "kind": "run-local-process",
          "program": "notify-send"
        },
        {
          "condition": {
            "left": "${env}",
            "op": "eq",
            "right": "prod"
          },
          "else": [
            {
              "command": "echo skipped",
              "kind": "send-command"
            }
          ],
          "kind": "conditional",
          "then": [
            {
              "automationId": "macro-01JDREC0000000000000000002",
              "kind": "run-automation"
            },
            {
              "body": [
                {
                  "command": "curl -fsS localhost/health #${iteration}",
                  "kind": "send-command"
                },
                {
                  "automationId": "macro-01JDREC0000000000000000001",
                  "kind": "run-automation"
                }
              ],
              "kind": "loop",
              "loop": {
                "count": 3,
                "kind": "count"
              }
            }
          ]
        },
        {
          "body": [
            {
              "condition": {
                "left": "${app}",
                "op": "contains",
                "right": "web"
              },
              "kind": "conditional",
              "then": [
                {
                  "delayMs": 100,
                  "kind": "wait"
                }
              ]
            }
          ],
          "continueOnError": true,
          "kind": "loop",
          "loop": {
            "condition": {
              "left": "${iteration}",
              "op": "lt",
              "right": "5"
            },
            "kind": "while"
          }
        }
      ],
      "tags": [
        "deploy"
      ],
      "triggers": [
        {
          "binding": "Ctrl+Alt+D",
          "kind": "hotkey"
        }
      ],
      "updatedAt": "2026-11-20T16:45:00Z"
    },
