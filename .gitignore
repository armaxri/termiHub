# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
dev.local.json
.dev-agent/
coverage
test-results
# Guided-manual / system-test run outputs — never checked in (keep the dir).
tests/reports/*
!tests/reports/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
# graft integration helpers are shared tooling; personal helpers stay local.
!.claude/helpers
.claude/helpers/*
!.claude/helpers/graft-hooks.cjs
!.claude/helpers/graft-statusline.cjs
# Project skills are shared; personal skills under .claude/skills/ stay local.
!.claude/skills
.claude/skills/*
!.claude/skills/sync-concept
!.claude/skills/graft
# Project agents are shared; personal agents under .claude/agents/ stay local.
!.claude/agents
.claude/agents/*
!.claude/agents/ui-design.md
!.claude/agents/state-machine.md
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cargo workspace target directory
/target/

# Windows reserved device names (created accidentally by Git Bash when scripts
# use redirection to NUL, CON, etc. instead of /dev/null).
NUL
CON
PRN
AUX

# Lock files from other package managers (we use pnpm)
package-lock.json
yarn.lock

# Concept mockup screenshot previews (generated)
docs/concepts/_assets/.preview/

# Python bytecode (e.g. scripts/*.py imported by tests)
__pycache__/
*.pyc

# Generated data-testid catalog — a local, regenerated reference for system-test
# authors, NOT committed. A single global committed file went stale on every
# open branch whenever any testid changed on develop, breaking unrelated PRs'
# CI (#1528). CI regenerates and verifies coverage instead of diffing it.
tests/system/testid-catalog.md

# Generated test-inventory + coverage-gap report (#1950) — a local, regenerated
# reference like the testid catalog above, NOT committed: a single committed file
# goes stale on every branch the moment any test changes on develop (#1528). CI
# regenerates it in a non-blocking step instead of diffing it.
tests/system/test-inventory.md
tests/system/test-inventory.json

# RDP sidecar (#1747) is an excluded crate with its own target dir
/rdp-sidecar/target/

# RDP sidecar binaries staged for Tauri `externalBin` bundling (#1754). Built by
# scripts/build-rdp-sidecar.sh --tauri-externalbin; never checked in.
/src-tauri/binaries/

# Generated when the host-loader round-trip test builds its cdylib fixture (#1995)
core/tests/fixtures/test-plugin/Cargo.lock

# graft's local graph cache — regenerable, not committed (run `graft build`).
# NOTE: keep this pattern exactly `graft/` (unanchored). `graft build` re-appends
# this literal line on every run when it's absent; anchoring it to /graft/ makes
# graft think it's missing and re-append, dirtying the tree each build.
graft/
# The unanchored pattern above also matches the *tracked* skill dir at
# .claude/skills/graft/ — re-admit it so the graft skill stays under version control.
!.claude/skills/graft/
